# --- Server ---
PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/dsa75

# --- Auth (use a long random string, e.g. `openssl rand -hex 48`) ---
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# --- Code execution (Judge0) ---
# Self-hosted: http://your-host:2358   RapidAPI: https://judge0-ce.p.rapidapi.com
JUDGE0_API_URL=
JUDGE0_API_KEY=
# Header carrying the key. Self-hosted: X-Auth-Token. RapidAPI: X-RapidAPI-Key
JUDGE0_AUTH_HEADER=X-Auth-Token
# Only needed for RapidAPI
JUDGE0_API_HOST=

# --- Challenge ---
CHALLENGE_START_DATE=2026-11-01
CHALLENGE_TIMEZONE=UTC

# --- One-time admin setup (used only by `npm run setup`; delete afterwards) ---
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
